params {
  //Primary inputs
  vcf = "test.vcf"
  gene_panels = "test_gene_list.csv"
  panel_name = "BreastCancer"
  vpot_params = "test_ppf.txt"
  annovar_params = "-protocol clinvar_20220320 -operation f"
  ref_name = "hg19"

  //Directories
  output_dir = "results"
  annovar_dir = "~/bin/annovar"  
  humandb_dir = "$annovar_dir/humandb"
  vpot_dir = "~/bin/VPOT-nf"

  //Optional inputs
  ref_fasta = "None"
  normalise = false
  column_file = "None"

  //Niche options (don't edit without reason!)
  intermediate_files = false
  pre_annotated = false
  enable_pass_filter = true
}